# Accounts and authorization are enforced by the application on every API route.
{
  servers {
    timeouts {
      read_header 10s
      read_body 30s
      idle 2m
    }
  }
}
{$HEADBOP_DOMAIN} {
  request_body {
    max_size 64MiB
  }
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy app:8000 {
    # Never pass an address supplied by an untrusted external client.
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    transport http {
      dial_timeout 5s
      response_header_timeout 120s
    }
  }
}
