# Export these variables in your shell; .env files are not loaded automatically.
HEADBOP_DATA_DIR=/tmp/headbop-ai
HEADBOP_TTL_HOURS=24
HEADBOP_MAX_PROJECTS=50
HEADBOP_ENV=development
HEADBOP_PUBLIC_ORIGIN=http://127.0.0.1:8000
HEADBOP_USER_MAX_PROJECTS=10
HEADBOP_MAX_STORAGE_MIB=2048
HEADBOP_USER_STORAGE_MIB=256
HEADBOP_RENDER_TIMEOUT_SECONDS=300
HEADBOP_MAX_VIDEO_MIB=64
# Production Compose reads this file automatically; set a real DNS hostname.
# HEADBOP_DOMAIN=studio.example.com
